# Copy to .env and edit:  cp .env.example .env

# IP address players use to reach this machine (required).
# Public IP for internet play, or the machine's LAN IP for LAN-only play.
PUBLIC_IP=203.0.113.10

# Optional: give players on your own network the LAN IP instead of PUBLIC_IP.
#LAN_IP=192.168.1.10
#LAN_NETWORK=192.168.1.0/24

#REALM_NAME=D2CS
#REALM_DESCRIPTION=PvPGN Closed Realm
#MOTD=Welcome to Diablo II!
#MAX_GAMES=50

# Shared secret between d2cs and D2GS (optional).
#D2GS_PASSWORD=

# Build PvPGN from a local checkout instead of GitHub:
#PVPGN_BUILD_CONTEXT=../pvpgn

# Only for examples/d2gs-only.compose.yml (PvPGN running elsewhere):
#D2CS_IP=192.168.1.10
