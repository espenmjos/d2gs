# Copy to .env and edit:  cp .env.example .env

# IP address of the PvPGN server running d2cs/d2dbs (required).
# Use the LAN/public IP of the host, not 127.0.0.1.
D2CS_IP=192.168.1.10

# Only needed if d2dbs runs on a different machine than d2cs.
#D2DBS_IP=192.168.1.10

# Must match "d2gs_password" in d2cs.conf (empty by default).
#D2CS_SECRET=

#MAX_GAMES=50
#MAX_GAME_LIFE=14400
#MOTD=Welcome to Diablo II!

# Telnet admin console on this port (default password: abcd123).
#ADMIN_PORT=8888
#ADMIN_PASSWORD_HASH=9e75a42100e1b9e0b5d3873045084fae699adcb0
